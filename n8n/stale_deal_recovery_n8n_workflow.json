      "id": "30333333-cccc-4444-8888-333333333333"
    },
    {
      "parameters": {
        "jsCode": "// Generate AI Re-engagement and recovery playbooks for each flagged deal\nconst item = $input.first().json;\nconst flaggedDeals = item.data?.flaggedDeals || [];\n\nconst enriched = flaggedDeals.map(deal => {\n  const urgency = deal.amount >= 100000 ? 'EXECUTIVE_PRIORITY' : 'STANDARD_RE_ENGAGE';\n  return {\n    dealId: deal.id,\n    title: deal.title,\n    amount: deal.amount,\n    daysInactive: deal.daysInactive,\n    urgency: urgency,\n    aiPlaybook: `Re-activate prospect with executive value proposition, updated ROI audit, or Q3 promotion incentive.`,\n    slackMessage: `🚨 *STALE DEAL DETECTED (≥ 7 Days Untouched)*\\n• *Deal:* ${deal.title}\\n• *Value:* $${deal.amount.toLocaleString()}\\n• *Inactivity:* ${deal.daysInactive} days\\n• *Action:* Auto-generated follow-up task dispatched to owner.`\n  };\n});\n\nreturn enriched.length > 0 ? enriched.map(e => ({ json: e })) : [{ json: { noDeals: true } }];"
      },
      "name": "4. AI Re-engagement Playbook Drafter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        20
      ],
      "id": "40444444-dddd-4444-8888-444444444444"
